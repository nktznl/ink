{
	"name": "@nktznl/ink",
	"type": "module",
	"version": "1.0.0",
	"description": "A lightweight, powerful TypeScript library for creating beautiful colorized console output with ANSI escape codes. Features chaining, themes, styles, and advanced effects.",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"console",
		"colors",
		"ansi",
		"terminal",
		"logging",
		"typescript",
		"cli",
		"chalk-alternative",
		"colorize",
		"text-styling"
	],
	"author": "Nikita Zanella",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nktznl/ink.git"
	},
	"bugs": {
		"url": "https://github.com/nktznl/ink/issues"
	},
	"homepage": "https://github.com/nktznl/ink#readme",
	"engines": {
		"node": ">=14.0.0"
	},
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/node": "^22.5.0",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^9.1.6",
		"jest": "^29.7.0",
		"prettier": "^3.6.2",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"tsup": "^8.2.4",
		"typescript": "^5.5.4"
	},
	"scripts": {
		"build": "tsup",
		"test": "jest",
		"coverage": "jest --coverage",
		"precommit": "npm run build && npm test",
		"version-minor": "npm version minor",
		"version-major": "npm version major",
		"version-patch": "npm version patch",
		"prepare": "husky",
		"lint": "eslint src/**/*.ts tests/**/*.ts",
		"lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
		"format": "prettier --write src/**/*.ts tests/**/*.ts",
		"clean": "rm -rf dist"
	}
}
